{
  "name": "fieldwork-geoguessr",
  "version": "0.14.24",
  "private": true,
  "type": "module",
  "description": "Adaptive GeoGuessr practice with curated locations and local learning feedback",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test src/tests/*.test.mjs scripts/*.test.mjs",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --target es2022 --module esnext --moduleResolution bundler --skipLibCheck src/lib/adaptive.ts src/lib/mastery.ts src/lib/fsrs.ts",
    "check": "npm test && npm run typecheck",
    "content:refresh": "node scripts/refresh-notes.mjs",
    "refresh": "bash tools/world-pack/refresh.sh",
    "content:build": "node scripts/content-assets.mjs",
    "usveg": "python3 tools/world-pack/usveg.py"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5"
  }
}
